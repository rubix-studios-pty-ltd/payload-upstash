{
  "name": "@rubixstudios/payload-upstash",
  "version": "1.0.3",
  "description": "Upstash KV adapter for Payload",
  "license": "MIT",
  "author": "Rubix Studios <hello@rubixstudios.com.au> (https://rubixstudios.com.au)",
  "homepage": "https://rubixstudios.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubix-studios-pty-ltd/payload-upstash.git"
  },
  "bugs": {
    "url": "https://github.com/rubix-studios-pty-ltd/payload-upstash/issues"
  },
  "maintainers": [
    {
      "name": "Rubix Studios",
      "email": "hello@rubixstudios.com.au",
      "url": "https://rubixstudios.com.au"
    }
  ],
  "type": "module",
  "keywords": ["payload", "payloadcms", "KV", "redis", "plugin", "typescript", "react", "nextjs"],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.json",
    "clean": "rimraf -g {dist,*.tsbuildinfo} && pnpm exec biome check --write && pnpm biome migrate --write",
    "update": "pnpm update --latest && pnpm install && pnpm prune && pnpm dedupe && pnpm run clean",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.32",
    "@types/react": "^19.2.14",
    "payload": "^3.84.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "payload": "^3.84.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/index.js",
    "provenance": true,
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@upstash/redis": "^1.37.0"
  },
  "packageManager": "pnpm@10.33.2"
}
